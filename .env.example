# App
APP_ENV=development
SERVER_ADDRESS=:8080
LOG_LEVEL=info
CONTEXT_TIMEOUT=10

# MongoDB
DB_HOST=localhost
DB_PORT=27017
DB_USER=
DB_PASS=
DB_NAME=shorts
DB_AUTH_SOURCE=admin
