# App
APP_ENV=development
SERVER_ADDRESS=:8080
LOG_LEVEL=info
CONTEXT_TIMEOUT=10
# Per-user link creation limit. Increase only for a dedicated benchmark deployment.
CREATE_LINK_RATE_LIMIT_PER_MINUTE=20
# Comma-separated public domains used by this shortener.
SHORTENER_DOMAINS=localhost
# Comma-separated CIDRs for reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Secret salt used to irreversibly hash analytics client IPs (32+ characters).
ANALYTICS_IP_SALT=

# MongoDB
DB_HOST=localhost
DB_PORT=27017
DB_USER=
DB_PASS=
DB_NAME=shorts
DB_AUTH_SOURCE=admin
# MONGODB_URI=mongodb://user:pass@host:27017/dbname?authSource=admin

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Analytics worker
REDIS_ANALYTICS_STREAM=stream:clicks
REDIS_ANALYTICS_CONSUMER_GROUP=analytics-workers
REDIS_ANALYTICS_CONSUMER_NAME=worker-1
ANALYTICS_BATCH_SIZE=100
ANALYTICS_POLL_TIMEOUT=2s
ANALYTICS_MAX_RETRIES=3
ANALYTICS_RETRY_BACKOFF=500ms
ANALYTICS_PENDING_MIN_IDLE=30s
ANALYTICS_PROCESS_TIMEOUT=30s
# Raw click retention in days; 0 disables TTL expiration.
CLICK_EVENTS_RETENTION_DAYS=0
ANALYTICS_MAX_QUERY_DAYS=366

# JWT — must each be at least 32 characters.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY_HOUR=2
REFRESH_TOKEN_EXPIRY_HOUR=168
